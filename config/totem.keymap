//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define TVP1 4
#define TVP2 5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt { quick-tap-ms = <220>; };

/ {
    combos {
        compatible = "zmk,combos";

        Copy {
            bindings = <&kp LG(C)>;
            key-positions = <22 23>;
            timeout-ms = <25>;
        };

        Paste {
            bindings = <&kp LG(V)>;
            key-positions = <23 24>;
            timeout-ms = <25>;
        };

        Cut {
            bindings = <&kp LG(X)>;
            key-positions = <22 24>;
        };

        CapsLock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <11 12 13 10>;
        };

        Hyper {
            bindings = <&sk LS(LA(LC(LEFT_GUI)))>;
            key-positions = <20 33>;
        };

        Smileys {
            bindings = <&kp LC(LG(SPACE))>;
            key-positions = <11 12>;
            timeout-ms = <25>;
        };

        Spotlight {
            bindings = <&kp LG(SPACE)>;
            key-positions = <12 13>;
            timeout-ms = <25>;
        };

        BF6_Grenade {
            bindings = <&kp R>;
            key-positions = <11 12 13>;
            layers = <5>;
        };

        BracketOpen {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <6 7>;
            timeout-ms = <25>;
        };

        BracketClosed {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 8>;
            timeout-ms = <25>;
        };

        BraceOpen {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 17>;
            timeout-ms = <25>;
        };

        BraceClosed {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <17 18>;
            timeout-ms = <25>;
        };

        CurlyOpen {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <27 28>;
            timeout-ms = <25>;
        };

        CurlyClosed {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <29 28>;
            timeout-ms = <25>;
        };

        LesserThan {
            bindings = <&kp LESS_THAN>;
            key-positions = <15 16>;
            timeout-ms = <25>;
        };

        GreaterThan {
            bindings = <&kp GREATER_THAN>;
            key-positions = <18 19>;
            timeout-ms = <25>;
        };

        Caret {
            bindings = <&kp CARET>;
            key-positions = <5 15>;
        };

        Underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <15 26>;
        };

        Plus {
            bindings = <&kp PLUS>;
            key-positions = <6 16>;
        };

        Minus {
            bindings = <&kp MINUS>;
            key-positions = <16 27>;
        };

        Asterix {
            bindings = <&kp ASTERISK>;
            key-positions = <7 17>;
        };

        Slash {
            bindings = <&kp SLASH>;
            key-positions = <17 28>;
        };

        Ampersand {
            bindings = <&kp AMPERSAND>;
            key-positions = <8 18>;
        };

        Pipe {
            bindings = <&kp PIPE>;
            key-positions = <18 29>;
        };

        At {
            bindings = <&kp AT_SIGN>;
            key-positions = <1 11>;
        };

        Hash {
            bindings = <&kp HASH>;
            key-positions = <2 12>;
        };

        Dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <3 13>;
        };

        Percent {
            bindings = <&kp PERCENT>;
            key-positions = <4 14>;
        };

        Grave {
            bindings = <&kp GRAVE>;
            key-positions = <11 22>;
        };

        Backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <23 12>;
        };

        Equal {
            bindings = <&kp EQUAL>;
            key-positions = <13 24>;
        };

        Tilde {
            bindings = <&kp TILDE>;
            key-positions = <14 25>;
        };

        Gaming_Layer {
            bindings = <&tog 5>;
            key-positions = <16 17 18>;
        };

        Screenshot {
            bindings = <&kp LG(LC(LS(NUMBER_4)))>;
            key-positions = <1 2 3>;
        };
    };

    macros {
        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp G &kp I &kp F>;
        };
    };

    behaviors {
        dot: dot {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT";
            bindings = <&kp PERIOD>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        colon: colon {
            compatible = "zmk,behavior-mod-morph";
            label = "COLON";
            bindings = <&kp COMMA>, <&kp SEMICOLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        questionmark: questionmark {
            compatible = "zmk,behavior-mod-morph";
            label = "QUESTIONMARK";
            bindings = <&kp QUESTION>, <&kp EXCLAMATION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        HoldTapHRM: HoldTapHRM {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAPHRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        Slash: Slash {
            compatible = "zmk,behavior-mod-morph";
            label = "SLASH";
            bindings = <&kp SLASH>, <&kp BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        HoldTapDot: HoldTapDot {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAPDOT";
            bindings = <&kp>, <&dot>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            hold-trigger-on-release;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
        };

        HoldTapColon: HoldTapColon {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAPCOLON";
            bindings = <&kp>, <&colon>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        HoldTapQuestion: HoldTapQuestion {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAPQUESTION";
            bindings = <&kp>, <&questionmark>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        TabAero: TabAero {
            compatible = "zmk,behavior-hold-tap";
            label = "TABAERO";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <0>;
            flavor = "hold-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        Colemak-DH {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "BASE";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     Q     ┃     W     ┃     F     ┃     P     ┃     G     ┃   ┃     J     ┃     L     ┃     U     ┃     Y     ┃     ;     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     A     ┃     R     ┃     S     ┃     T     ┃     D     ┃   ┃     H     ┃     N     ┃     E     ┃     I     ┃     O     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃     Q     ┃     Z     ┃     X     ┃     C     ┃     V     ┃     B     ┃   ┃     K     ┃     M     ┃     ,     ┃     .     ┃     /     ┃     \     ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    DEL    ┃    TAB    ┃    SPC    ┃   ┃   ENTER   ┃           ┃   BSPC    ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
                            &kp Q                &kp W                   &kp E                   &kp R                     &kp T             &kp Y      &kp U                     &kp U                     &kp O                   &kp APOSTROPHE
                            &kp A                &kp S                   &kp D                   &kp F                     &kp G             &kp H      &kp J                     &kp K                     &kp L                   &kp P
&TabAero LS(LA(LCTRL)) TAB  &HoldTapHRM RCTRL Z  &HoldTapHRM LEFT_ALT X  &HoldTapHRM LEFT_GUI C  &HoldTapHRM LEFT_SHIFT V  &kp B             &kp N      &HoldTapHRM LEFT_SHIFT M  &HoldTapColon LEFT_GUI 0  &HoldTapDot LEFT_ALT 0  &HoldTapQuestion LCTRL 0  &TabAero LS(LA(RCTRL)) F20
                                                                         &lt 4 ESCAPE            &lt 1 SPACE               &sk LEFT_SHIFT    &kp ENTER  &lt 2 BACKSPACE           &lt 1 ESCAPE
            >;
        };

        Navigation {
            bindings = <
              &trans  &kp LS(LA(LC(D)))                          &kp LS(LA(LC(S)))                          &kp LS(LA(LC(A)))                            &trans    &trans  &kp HOME  &kp UP_ARROW  &kp END    &trans
              &trans  &kp LS(LC(LA(NUMBER_4)))                   &kp LS(LA(LC(N5)))                         &kp LS(LA(LC(NUMBER_6)))                     &trans    &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans
&kp LEFT_GUI  &trans  &HoldTapHRM LEFT_ALT LS(LA(LC(NUMBER_1)))  &HoldTapHRM LEFT_GUI LS(LA(LC(NUMBER_2)))  &HoldTapHRM LEFT_SHIFT LS(LA(LC(NUMBER_3)))  &trans    &trans  &trans    &trans        &trans     &trans  &trans
                                                                 &trans                                     &trans                                       &trans    &trans  &trans    &trans
            >;

            label = "NAV";
        };

        Numbers {
            bindings = <
        &kp LEFT_PARENTHESIS     &kp N7                         &kp N8                         &kp N9                           &kp RIGHT_PARENTHESIS    &kp F12  &kp F7                     &kp F8                   &kp F9                   &trans
        &kp MINUS                &kp NUMBER_4                   &kp N5                         &kp NUMBER_6                     &kp PLUS                 &kp F11  &kp F4                     &kp F5                   &kp F6                   &trans
&trans  &HoldTapHRM LCTRL SLASH  &HoldTapHRM LEFT_ALT NUMBER_1  &HoldTapHRM LEFT_GUI NUMBER_2  &HoldTapHRM LEFT_SHIFT NUMBER_3  &kp ASTERISK             &kp F10  &HoldTapHRM LEFT_SHIFT F1  &HoldTapHRM LEFT_GUI F2  &HoldTapHRM LEFT_ALT F3  &kp LCTRL  &trans
                                                                &kp COMMA                      &kp N0                           &kp PERIOD               &trans   &trans                     &trans
            >;

            label = "NUM";
        };

        Symbol {
            bindings = <
        &kp GRAVE  &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS          &kp PIPE         &kp CARET    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOLLAR  &kp SQT
        &trans     &kp ASTERISK   &Slash            &kp EQUAL          &kp AMPERSAND    &kp HASH     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none       &trans
&trans  &kp TILDE  &kp PLUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PERCENT      &kp AT_SIGN  &kp COLON             &colon                 &dot        &questionmark  &trans
                                  &trans            &trans             &trans           &trans       &trans                &trans
            >;

            label = "SYM";
        };

        Utility {
            bindings = <
             &bt BT_NXT  &kp C_PREVIOUS     &kp K_MUTE        &kp C_NEXT       &trans    &trans  &kp C_PREV    &kp K_MUTE        &kp C_NEXT       &trans
             &bt BT_PRV  &kp C_VOLUME_DOWN  &kp C_PLAY_PAUSE  &kp C_VOLUME_UP  &trans    &trans  &kp C_VOL_DN  &kp C_PLAY_PAUSE  &kp C_VOLUME_UP  &trans
&bootloader  &bt BT_CLR  &trans             &trans            &trans           &trans    &trans  &trans        &trans            &trans           &trans  &sys_reset
                                            &trans            &trans           &trans    &trans  &trans        &trans
            >;

            label = "UTIL";
        };

        Gaming_Battlefield {
            bindings = <
            &kp NUMBER_1    &kp G  &kp X  &kp E      &kp NUMBER_3    &trans  &trans  &trans  &trans  &trans
            &kp LEFT_SHIFT  &kp A  &kp W  &kp D      &kp NUMBER_4    &trans  &trans  &trans  &trans  &trans
&kp ESCAPE  &kp NUMBER_2    &kp C  &kp S  &kp F      &kp N5          &trans  &trans  &trans  &trans  &trans  &trans
                                   &kp V  &kp SPACE  &kp LCTRL       &trans  &trans  &trans
            >;
        };
    };
};
